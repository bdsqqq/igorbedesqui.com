{
  "name": "@igorbedesqui/web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && tsc --noEmit",
    "preview": "vite preview",
    "start": "node .output/server/index.mjs",
    "routes:generate": "tsr generate",
    "check:ui": "node --test --test-concurrency=1 scripts/check-ariakit-migration.test.mjs scripts/document-geometry.test.mjs scripts/progressive-primitives.test.mjs src/routes/*/*/-*.test.mjs && node scripts/check-ariakit-migration.mjs",
    "check:api": "node scripts/check-progressive-types.mjs",
    "test:ui": "playwright test --config scripts/ariakit-migration.playwright.config.mjs",
    "lint": "pnpm routes:generate && pnpm check:ui && oxlint --type-aware --format=stylish --type-check --report-unused-disable-directives",
    "lint:fix": "pnpm routes:generate && oxlint --type-aware --format=stylish --type-check --fix --report-unused-disable-directives",
    "lint:github": "pnpm routes:generate && pnpm check:ui && oxlint --type-aware --type-check --format=github --report-unused-disable-directives",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "@ariakit/react": "^0.4.43",
    "@ariakit/tailwind": "0.2.10",
    "@fontsource-variable/geist-mono": "^5.2.7",
    "@fontsource/ibm-plex-serif": "^5.2.7",
    "@igorbedesqui/pattern-language": "workspace:*",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "@unpic/placeholder": "^0.1.2",
    "@unpic/react": "^1.0.2",
    "@vercel/og": "^0.6.8",
    "class-variance-authority": "^0.7.1",
    "motion": "^11.18.2",
    "nanoid": "^5.1.16",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-element-to-jsx-string": "^17.0.1",
    "react-is": "^19.2.4",
    "remark-gfm": "^4.0.1",
    "streamdown": "2.5.0",
    "sugar-high": "^0.6.1",
    "tailwind-merge": "^3.7.0",
    "unpic": "^4.2.2",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4",
    "@tanstack/router-cli": "1.167.18",
    "@types/node": "^24.10.12",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@unpic/core": "^1.0.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitejs/plugin-rsc": "^0.5.30",
    "agentation": "^3.0.2",
    "fontaine": "^0.8.0",
    "image-size": "^2.0.2",
    "nitro": "npm:nitro-nightly@3.0.1-20260508-123613-d2e64906",
    "oxfmt": "^0.28.0",
    "oxlint": "^1.43.0",
    "oxlint-tsgolint": "^0.11.5",
    "tailwindcss": "^4",
    "tw-animate-css": "^1",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vite-imagetools": "^10.0.0"
  },
  "license": "MIT"
}
